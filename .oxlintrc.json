{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": [
      "warn",
      { "allow": ["**/*.css", "@testing-library/jest-dom/vitest", "fake-indexeddb/auto"] }
    ]
  },
  "overrides": [
    {
      "files": ["src/core/**", "src/content/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/ui/**",
                  "@/runner/**",
                  "@/storage/**",
                  "**/ui/**",
                  "**/runner/**",
                  "**/storage/**",
                  "react",
                  "react-*",
                  "idb"
                ],
                "message": "core and content are pure TypeScript: no UI, runner, DOM or storage."
              }
            ]
          }
        ]
      }
    }
  ]
}
